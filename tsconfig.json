{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "include": [ "app/**/*", "electron/**/*" ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#electron/*": [ "./electron/*" ],
      "#types/*": [ "./app/types/*" ]
    },
    "types": [ "node" ]
  }
}
